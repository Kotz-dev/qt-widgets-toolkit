{
  "name": "qtwidgetstoolkit",
  "version": "0.1.3.1",
  "port-version": 0,
  "description": "Toolkit of custom Qt Widgets components (Animation, Blur, Frame, Geometry, ProgressBar, Splitter, Window helpers).",
  "homepage": "https://github.com/Kotz-dev/qt-widgets-toolkit",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "widgets"
      ]
    }
  ]
}
